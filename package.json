{
  "name": "jungle-nft-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --mode mock",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'src/**/*.test.{ts,tsx}'",
    "test:int": "vitest run --exclude 'src/**/*.spec.{ts,tsx}' --passWithNoTests",
    "test:cov": "vitest run --coverage",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:safari": "playwright test --config=playwright.safari.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "generate": "node scripts/generate-feature.mjs",
    "dev:mock": "vite --mode mock",
    "build:mock": "pnpm typecheck && vite build --mode mock",
    "preview:mock": "vite preview --mode mock",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "test:public": "playwright test --config=playwright.public.config.ts",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "^1.170.41",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "msw": "2.15.0",
    "radix-ui": "1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.71.2",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.91.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.39",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.1.2",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.19",
    "pnpm": ">=11"
  },
  "type": "module",
  "msw": {
    "workerDirectory": ["public"]
  }
}
